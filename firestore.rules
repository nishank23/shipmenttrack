rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Active or archived: tracking data stays readable after archiving.
    function ownsShipment(shipmentId) {
      let activePath = /databases/$(database)/documents/shipments/$(shipmentId);
      let archivedPath = /databases/$(database)/documents/archived_shipments/$(shipmentId);
      return (exists(activePath) && get(activePath).data.uid == request.auth.uid)
        || (exists(archivedPath) && get(archivedPath).data.uid == request.auth.uid);
    }

    // Written only by Cloud Functions (Admin SDK bypasses these rules).
    // Users can edit the ETA, but never the carrier-reported tracking events.
    function serverOwnedShipmentFields() {
      return ['latestEvent', 'eventCount', 'trackingStatus', 'trackingError',
              'etaSource', 'etaVerified', 'etaChangeCount', 'lastEtaSyncAt',
              'autoArchiveDisabled', 'restoredAt'];
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /shipments/{shipmentId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.keys().hasAny(serverOwnedShipmentFields());

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(serverOwnedShipmentFields());
    }

    // Moved here by Cloud Functions (auto when the empty container is
    // returned, or via the setShipmentArchived callable). Read-only for users.
    match /archived_shipments/{shipmentId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // Tracking cache and ETA history are server-written, readable by the owner.
    match /tracking_cache/{shipmentId} {
      allow read: if signedIn() && ownsShipment(shipmentId);
      allow write: if false;
    }

    match /eta_history/{entryId} {
      allow read: if signedIn() && ownsShipment(resource.data.shipmentId);
      allow write: if false;
    }
  }
}
